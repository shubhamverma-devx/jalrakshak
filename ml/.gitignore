# `python download_data.py` se koi bhi 3 minute mein dobara laa sakta hai.
data/

# ---- Trained weights (98 MB) ------------------------------------------------
# GitHub ki 100 MB file limit ke bilkul kinare pe hai, aur har retrain pe badalta hai.
# Repo mein METRICS aur NOTEBOOK jaate hain (wahi saboot hai ki khud train kiya) —
# weights Release/Drive link se share karo, ya Git LFS use karo.
models/*.pth
models/*.pt
models/*.onnx

# ---- Python -----------------------------------------------------------------
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

