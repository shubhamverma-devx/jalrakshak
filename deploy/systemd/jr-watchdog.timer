# KYUN systemd timer (cron nahi): Persistent + boot ke baad apne aap, aur har run ka
# log journalctl mein. OnBootSec=3min: boot pe services ko khud uthne ka time do.
[Unit]
Description=Run jr-watchdog every 2 minutes

[Timer]
OnBootSec=3min
OnUnitActiveSec=2min
AccuracySec=15s

[Install]
WantedBy=timers.target
