# =============================================================================
#  JalRakshak scheduler — /etc/cron.d/jalrakshak
# =============================================================================
#  Laravel scheduler har minute; wo khud dekhta hai ki risk:compute (har 30 min) ka
#  time hua ya nahi.
#
#  DHER NA LAGE (pile-up), do taale:
#   1. flock -n : pichhla schedule:run abhi chal raha ho to naya turant chhod deta hai
#                 (wait nahi karta) — 1GB pe 5 PHP process ek saath = OOM.
#   2. withoutOverlapping(25) routes/console.php mein — risk:compute ka apna taala,
#      25 min mein expire (OOM-kill ke baad 24 ghante atka nahi rehta).
#  timeout 25m: koi run kabhi bhi 25 min se lamba nahi.
# =============================================================================
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

* * * * * www-data flock -n /tmp/jr-schedule.lock timeout 25m php /var/www/jalrakshak/backend/artisan schedule:run >> /dev/null 2>&1
